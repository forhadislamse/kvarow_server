model InstructorSkill {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Link to User
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Skill stored as simple string
  skillName String

  // Profile fields
  teachingLevel     SkillLevel   @default(BEGINNER)
  educationTraining String?
  hourlyRateCents   Float?
  teachingMode      TeachingMode @default(ONLINE)

  availableDays        String[] // array of strings
  availabilitySchedule Json? // {"from": "...", "to": "..."}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  // Prevent duplicate skill profile for same user
  @@unique([userId, skillName])
}

enum TeachingMode {
  ONLINE
  IN_PERSON
  BOTH
}

model Goal {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Link to User
  userId String @db.ObjectId
  user   User   @relation("UserGoal", fields: [userId], references: [id], onDelete: Cascade)

  // Form Fields
  title       String
  targetMonth DateTime? // Optional: যদি user month না দেয়, null হবে

  // Practice Duration (in minutes)
  practiceDurationMinutes Int? // Optional

  // Individual goals
  specificGoals String[] @default([]) // Optional, default empty array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

