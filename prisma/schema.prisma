model Goal {
  id                     String     @id @default(auto()) @map("_id") @db.ObjectId

  // Link to User
  userId                 String     @db.ObjectId
  user                   User       @relation("UserGoal",fields: [userId], references: [id], onDelete: Cascade)

  // Form Fields
  title                  String
  targetMonth            DateTime?  // Optional: যদি user month না দেয়, null হবে

  // Practice Duration (in minutes)
  practiceDurationMinutes Int?       // Optional

  // Individual goals
  specificGoals          String[]  @default([]) // Optional, default empty array

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model Payment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)

  amount         Float?        @default(0)
  paymentType    PaymentType?  @default(CARD) // CASH, CARD
  paymentMethod  String?       @default("") // CARD, WALLET, STRIPE
  paymentGateway String?       @default("") // Stripe, PayPal, etc.
  currency       String?       @default("USD")
  // method   PaymentMethod @default(STRIPE)
  status         PaymentStatus @default(PENDING)

  transactionId String? // Stripe/Wallet transaction reference
  paymentIntent String? // Stripe intent id or equivalent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentType {
  CASH
  CARD
}

enum RecurringInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING
  FAILED
  COMPLETED
  REFUNDED
  REQUIRES_CAPTURE
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  data      String?
  targetId  String?          @default("")
  // targetId  String?          @db.ObjectId
  slug      String?          @default("")
  fcmToken  String?          @default("")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // target    User?            @relation("ReceivedNotifications", fields: [targetId], references: [id], onDelete: Cascade)
  @@map("notifications")
}

enum NotificationType {
  GENERAL
  LOGIN_SUCCESS
  DONATION
  REGISTRATION
  PASSWORD_RESET
  EVENT
}

enum UserRole {
  USER
  TEACHER
  ADMIN
}

enum ReqStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AdminReq {
  APPROVED
  PENDING
  DECLINED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Gender {
  Male
  Female
  Other
}

model Room {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chats      Chat[]
}

model Chat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String
  receiverId String
  roomId     String   @db.ObjectId
  message    String
  images     String[] @default([])
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id])
}
