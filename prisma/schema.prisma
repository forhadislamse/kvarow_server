generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  email            String     @unique
  password         String
  age              Int?       @default(0)
  fullName         String?    @default("")
  professionalName String?    @default("")
  profileImage     String?    @default("")
  phone            String?    @default("")
  about            String?    @default("")
  otp              Int?       @default(0)
  role             UserRole   @default(USER)
  otpExpiresAt     DateTime?  @default(now())
  status           UserStatus @default(ACTIVE)
  gender           Gender     @default(Male)
  isOnline         Boolean    @default(false)
  isVerifyEmail    Boolean    @default(false)
  adminReq         AdminReq   @default(PENDING)

  categories    String[]    @default([])
  subCategories String[]    @default([])
  skills        String[]    @default([])
  skillLevel    SkillLevel? @default(BEGINNER)

  address  String? @default("")
  location String? @default("")
  lat      Float?  @default(0)
  lng      Float?  @default(0)

  isDeleted Boolean @default(false)

  isNotificationOn Boolean @default(false)
  isUserOnline     Boolean @default(false)
  dob              String? @default("")
  fcmToken         String? @default("")

  stripeCustomerId String? @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Notification     Notification[]
  payments         Payment[]      @relation("UserPayments")
  goals            Goal[]         @relation("UserGoal")
  sentReviews      Review[]       @relation("SenderReviews") // user → reviews he sent
  receivedReviews  Review[]       @relation("ReceiverReviews") // user → reviews he received
  studentOrders    Order[]        @relation("StudentOrders") // user as student
  instructorOrders Order[]        @relation("InstructorOrders") // user as instructor

  // Back-reference for InstructorSkill.user relation
  instructorSkills InstructorSkill[]

  // ✨ Multi-step interest relation
  // interests UserCategoryInterest[]

  @@map("users")
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String        @unique
  subCategories SubCategory[]
  // usersInterested  UserCategoryInterest[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skills     Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId])
}

model Skill {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  image         String?      @default("")
  subCategoryId String       @db.ObjectId
  subCategory   SubCategory  @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  levels        SkillLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, subCategoryId])
}

