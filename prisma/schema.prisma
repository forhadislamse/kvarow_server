model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  price Float? // per-hour rate, user input
  hours Int    // কত ঘন্টা hire করা হয়েছে
  orderId String @unique // Unique identifier for the order

  // Instructor Skill reference (যে skill hire করা হয়েছে)
  skillId String @db.ObjectId
  skill   InstructorSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // Instructor info
  instructorId String @db.ObjectId
  instructor   User @relation("InstructorOrders", fields: [instructorId], references: [id], onDelete: Cascade)

  // Student / buyer info
  studentId String @db.ObjectId
  student   User @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Cascade)

  // Payment status
  paymentMethod PaymentType   @default(CARD)
  paymentStatus PaymentStatus @default(PENDING)

  // Actual amounts
  teacherReceiveStatus  PaymentStatus @default(PENDING)
  userPayAmount         Float? // student pays
  teacherReceivedAmount Float? // instructor receives
  adminEarnings         Float? // admin earnings

  // Order status
  status OrderStatus @default(PENDING)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[] @relation("OrderPayments")

  @@map("orders")
}


enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}


