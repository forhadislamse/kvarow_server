# Database Configuration (MongoDB Atlas Connection URI)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"
NODE_ENV="development"
PORT=13001

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=12

# JWT Authentication Configuration
JWT_SECRET="your_jwt_access_secret_key"
EXPIRES_IN="365d"
REFRESH_TOKEN_SECRET="your_jwt_refresh_secret_key"
REFRESH_TOKEN_EXPIRES_IN="365d"

# Password Reset Configuration
RESET_PASS_TOKEN="your_reset_password_secret_key"
RESET_PASS_TOKEN_EXPIRES_IN="5m"
RESET_PASS_LINK="http://localhost:3001/reset-password"

# Email Services (Nodemailer / SendGrid / Brevo)
EMAIL="your_email@domain.com"
APP_PASS="your_gmail_app_password"

# SendGrid SMTP Credentials
smtp_server="smtp.sendgrid.net"
smtp_port=587
smtp_user="apikey"
smtp_pass="your_sendgrid_api_key"

# Brevo (Sendinblue) Email Credentials
BREVO_API_KEY="your_brevo_api_key"
BREVO_API_SECRET="your_brevo_api_secret"
BREVO_EMAIL="your_brevo_verified_sender_email"
BREVO_SENDER_NAME="Kvarow"

# DigitalOcean Spaces Object Storage (CDN & File Uploads)
DO_SPACE_ENDPOINT="https://blr1.digitaloceanspaces.com"
DO_SPACE_CDN="https://blr1.cdn.digitaloceanspaces.com"
DO_SPACE_ORIGIN_ENDPOINT="https://yourspace.blr1.digitaloceanspaces.com"
DO_SPACE_CDN_ENDPOINT="https://yourspace.blr1.cdn.digitaloceanspaces.com"
DO_SPACE_ACCESS_KEY="your_do_space_access_key"
DO_SPACE_SECRET_KEY="your_do_space_secret_key"
DO_SPACE_BUCKET="your_do_space_bucket_name"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Stripe Payments & Connect Account Credentials
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_ADMIN_ACCOUNT_ID="acct_your_stripe_admin_account_id"
STRIPE_WEBHOOK_KEY="whsec_your_stripe_webhook_signing_secret"

# Frontend / Client URLs
FRONTEND_BASE_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
